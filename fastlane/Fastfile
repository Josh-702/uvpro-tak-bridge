# Signing material is read from the environment. Nothing in this file is a secret.

default_platform(:ios)

platform :ios do
  desc "Build a signed IPA and upload it to TestFlight"
  lane :beta do
    setup_ci if ENV["CI"]
    # setup_ci turns readonly on. The first run has to create the certificate.
    ENV["MATCH_READONLY"] = "false"
    UI.message("Match readonly mode is off, so this run can create certificates.")

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_P8"),
      is_key_content_base64: false
    )

    # match cannot make a profile until this bundle ID exists on the team.
    produce(
      api_key: api_key,
      app_identifier: "net.wa7brm.openuvbridge",
      app_name: "Open UV Bridge",
      sku: "openuvbridge",
      language: "English",
      team_id: ENV["APPLE_TEAM_ID"],
      skip_itc: false
    )

    match(
      type: "appstore",
      readonly: false,
      git_url: ENV.fetch("MATCH_GIT_URL"),
      git_branch: "master",
      git_basic_authorization: ENV.fetch("MATCH_GIT_BASIC_AUTHORIZATION"),
      git_full_name: "Open UV Bridge",
      git_user_email: "open-uv-bridge@users.noreply.github.com",
      app_identifier: "net.wa7brm.openuvbridge",
      team_id: ENV["APPLE_TEAM_ID"],
      api_key: api_key
    )

    gym(
      project: "OpenUVBridge.xcodeproj",
      scheme: "OpenUVBridge",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      clean: true
    )

    pilot(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      ipa: Actions.lane_context[SharedValues::IPA_OUTPUT_PATH]
    )
  end
end
