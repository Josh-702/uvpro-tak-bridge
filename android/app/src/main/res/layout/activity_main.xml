<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/field_background"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/field_amber"
            android:textSize="22sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/field_panel"
            android:padding="12dp"
            android:textColor="@color/field_text" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/radio_hint"
            android:textColor="@color/field_text" />
        <EditText
            android:id="@+id/callsign"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Callsign, blank until it is yours"
            android:inputType="textCapCharacters"
            android:textColor="@color/field_text"
            android:textColorHint="@color/field_amber" />
        <Button
            android:id="@+id/scan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Look for BLE KISS" />
        <Button
            android:id="@+id/spp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Classic SPP fallback" />
        <TextView
            android:id="@+id/stations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/field_text" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/itak_hint"
            android:textColor="@color/field_text" />
        <Button
            android:id="@+id/share"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add to ATAK" />
        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:textColor="@color/field_amber" />
    </LinearLayout>
</ScrollView>
